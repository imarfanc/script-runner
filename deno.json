{
  "lock": true,
  "imports": {
    "@fortawesome/free-solid-svg-icons": "npm:@fortawesome/free-solid-svg-icons@7.3.1",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/yaml": "jsr:@std/yaml@1.0.10"
  },
  "tasks": {
    "choose": "deno run -A _other/scripts/choose.ts",
    "dev": "deno run -A _other/scripts/serve.ts dev",
    "start": "deno run -A _other/scripts/serve.ts start",
    "test": "deno test -A",
    "check": "deno fmt --check && deno lint && deno check src/main.ts && deno test -A",
    "git:history": "deno run -A _other/scripts/git-history.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": { "lineWidth": 100, "exclude": [".vscode/**", "data/scripts/**"] },
  "lint": { "exclude": [".vscode/**", "data/scripts/**"] }
}
